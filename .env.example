# ─────────────────────────────────────────────────────────────────────────────
#  Copy this file to `.env` and fill in only the providers you want:
#
#      cp .env.example .env
#
#  Every key is OPTIONAL. MOFChat runs fully offline with local Ollama models
#  (or with no LLM at all, using its rule-based planner). Models whose key is
#  missing show as unavailable in the app's model picker - nothing crashes.
#
#  NEVER commit your real .env file (it is listed in .gitignore).
# ─────────────────────────────────────────────────────────────────────────────

# Google Gemini - free tier. https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Groq - free tier, very fast (8,000 tokens/minute per model). https://console.groq.com/keys
GROQ_API_KEY=

# OpenRouter - free models (":free"), about 50 free requests/day. https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Ollama - local, no key needed. Only change if the server is not on the default port.
OLLAMA_BASE_URL=http://localhost:11434

# Optional: default model and fallback order (ids from `python -m mofchat.llm --list`)
# (unset: gemini-3.1-flash-lite, then gpt-oss-120b, qwen3.8-27b, llama3-local - see docs/RESULTS.md 1b)
# MOFCHAT_MODEL=gemini-3.1-flash-lite
# MOFCHAT_FALLBACK=gpt-oss-120b,llama3-local
